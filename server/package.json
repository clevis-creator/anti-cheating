{
  "name": "examai-server",
  "version": "1.0.0",
  "description": "AI Examination System - Backend API",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "seed": "node utils/seed.js",
    "db:check": "node utils/db-check.js",
    "env:check": "node utils/validate-env.js",
    "smtp:check": "node ../tools/check-smtp.mjs",
    "migrate:run": "node utils/migrate.js",
    "seed:validate": "node utils/validate-seed.js",
    "integration:check": "node utils/integration-check.js",
    "deploy:verify": "node ../tools/deploy-verify.js",
    "test": "node --test tests/**/*.test.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.5",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "examai": "file:..",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.5.0",
    "express-validator": "^7.2.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.3",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^9.0.5",
    "openai": "^4.77.0",
    "pdfkit": "^0.15.2",
    "socket.io": "^4.8.1",
    "xss-clean": "^0.1.4"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
