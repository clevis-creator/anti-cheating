PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/examai?retryWrites=true&w=majority
JWT_SECRET=your_super_secret_jwt_key_change_in_production
MEDIA_SIGN_SECRET=your_media_signing_secret_change_in_production
JWT_EXPIRE=7d
CLIENT_URL=http://127.0.0.1:5173
# CLIENT_URL MUST be set to the deployed frontend origin in production (config fails fast when unset).
# It is the base URL used in email verification and password-reset links.
SEB_CONFIG_KEY_HASH=

# Email (Nodemailer) — REQUIRED in production for verification/reset emails to be delivered.
# Without these, emails are skipped and logged, so students cannot receive a verification link.
#
# Gmail setup (do NOT use your normal account password):
#   1. Enable 2-Step Verification on the Gmail account.
#   2. Create a 16-character App Password at https://myaccount.google.com/apppasswords
#   3. Set EMAIL_USER to that exact Gmail address and EMAIL_PASS to the App Password.
#
# EMAIL_FROM should normally match the authenticated account (or a verified Gmail alias).
# A placeholder domain such as noreply@examai.com will be REJECTED by smtp.gmail.com:
# "The From address does not match the authenticated identity."
# Email transport — pick ONE provider. Everything routes through sendEmail().
#
# EMAIL_PROVIDER=smtp (default): Nodemailer on EMAIL_HOST/PORT/USER/PASS.
#   Requires outbound access to the SMTP port (587). Some hosts (Render)
#   cannot reliably reach smtp.gmail.com:587 — the connection stalls, times
#   out, and verification mail is never sent. Timeouts are set so failures
#   surface in ~10-20s instead of hanging the request.
#
# EMAIL_PROVIDER=resend: HTTPS transactional API (works on Render/Vercel —
#   no open SMTP ports needed). Create an API key at https://resend.com,
#   verify a sender domain, and point EMAIL_FROM at that domain
#   (e.g. "ExamAI <no-reply@yourappdomain.com>"). Requires RESEND_API_KEY.
EMAIL_PROVIDER=smtp
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
EMAIL_FROM=ExamAI <your_email@gmail.com>
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# AI Providers (admin can also set via Settings UI)
GEMINI_API_KEY=
OPENAI_API_KEY=
DEFAULT_AI_PROVIDER=gemini

# Proctoring & monitoring
PROCTORING_RETENTION_DAYS=30
WARNING_COOLDOWN_MS=10000
# Demo mode: disables email-verification enforcement. Set to false (or omit) in production.
MARKETING_MODE=true
# STUDENT_LIMIT=500
# Optional: shared online-student state across instances (requires: npm install ioredis)
# REDIS_URL=redis://127.0.0.1:6379
# REQUIRE_EMAIL_VERIFICATION=false
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
